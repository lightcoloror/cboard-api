PORT=10010
HOST=127.0.0.1
MONGO_URL=mongodb://127.0.0.1:27017/cboard-api
CBOARD_APP_URL=http://127.0.0.1:3000
CBUILDER_APP_URL=http://127.0.0.1:3000
JWT_SECRET=replace-with-local-jwt-secret
JWT_ISSUER=cboard-local
API_SESSION_SECRET=replace-with-local-session-secret

# OAuth can be left blank for pure local email/password runtime.
GOOGLE_APP_ID=
GOOGLE_APP_SECRET=
GOOGLE_CALLBACK_URL=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=
APPLE_APP_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CALLBACK_URL=

# Optional for local account creation through the normal signup flow.
SENDGRID_API_KEY=

# Optional PicInterpreter communication AI. The generic OpenAI-compatible
# configuration takes precedence when AI_API_KEY is set. Keys stay on the API
# server and are never bundled into CBoard Web or the WeChat mini program.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=15000

# Optional caregiver-triggered AAC pictogram generation. An explicit image
# model is required; text AI configuration alone never enables this feature.
AI_IMAGE_MODEL=gpt-image-1
AI_IMAGE_REQUEST_TIMEOUT_MS=120000

# Optional server-side MP3 speech fallback. Dedicated values override the
# generic AI_* provider. Text and generated audio are handled transiently.
AI_TTS_PROVIDER=
AI_TTS_API_KEY=
AI_TTS_BASE_URL=https://api.openai.com/v1
AI_TTS_MODEL=gpt-4o-mini-tts
AI_TTS_VOICE=alloy
# Comma-separated public choices. The default voice is always included.
AI_TTS_VOICES=alloy
AI_TTS_TIMEOUT_MS=25000

# Optional current Volcengine Doubao Seed TTS provider. Set AI_TTS_PROVIDER to
# volcengine and keep the new-console API key on this server only.
VOLCENGINE_TTS_API_KEY=
VOLCENGINE_TTS_BASE_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional/sse
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_TTS_VOICE=zh_female_vv_uranus_bigtts
VOLCENGINE_TTS_VOICES=zh_female_vv_uranus_bigtts
VOLCENGINE_TTS_TIMEOUT_MS=25000

# Existing CBoard Azure OpenAI deployments remain supported as a fallback.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_IMAGE_DEPLOYMENT=

# Optional source-preserving Cantonese audio recognition. Credentials stay on
# this API server and are never bundled into CBoard Web or the mini program.
COMMUNICATION_DIALECT_ASR_PROVIDER=
COMMUNICATION_TENCENTCLOUD_ASR_SECRET_ID=
COMMUNICATION_TENCENTCLOUD_ASR_SECRET_KEY=
COMMUNICATION_TENCENTCLOUD_ASR_REGION=
COMMUNICATION_DIALECT_ASR_TIMEOUT_SECONDS=30
VOLCENGINE_ASR_API_KEY=
VOLCENGINE_ASR_APP_KEY=
VOLCENGINE_ASR_ACCESS_KEY=
VOLCENGINE_ASR_BASE_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
VOLCENGINE_ASR_RESOURCE_ID=volc.bigasr.auc_turbo

# Optional OpenSymbols fallback after ARASAAC misses. Request a shared secret
# from https://www.opensymbols.org/api and keep it on this API server only.
OPENSYMBOLS_SECRET=

# Optional Global Symbols v2 search. Keep the API key on this server. Use a
# distinct random proxy secret; JWT_SECRET remains a compatibility fallback.
GLOBALSYMBOLS_API_KEY=
PICTOGRAM_IMAGE_PROXY_SECRET=

# Optional comma-separated HTTPS hostnames for public CBoard board images.
# Only images already referenced by a public board can use the offline proxy.
PUBLIC_BOARD_IMAGE_HOSTS=

# Optional one-click background removal for private pictograms. Keep provider
# credentials on this API server. Supported providers: rembg, removebg.
# rembg defaults to http://127.0.0.1:7000/api/remove and needs no API key.
BACKGROUND_REMOVAL_PROVIDER=
BACKGROUND_REMOVAL_API_URL=
BACKGROUND_REMOVAL_API_KEY=
BACKGROUND_REMOVAL_TIMEOUT_MS=15000

# Optional local verification of authenticated enhancement cost protection.
# Production enables this through the validated deployment template.
COMMUNICATION_ENHANCEMENT_RATE_LIMIT_ENABLED=false
COMMUNICATION_ENHANCEMENT_POINTS_PER_MINUTE=30
COMMUNICATION_ENHANCEMENT_MONTHLY_POINTS=1000
COMMUNICATION_AI_TOKEN_QUOTA_ENABLED=false
COMMUNICATION_AI_MONTHLY_TOKEN_QUOTA=1000000
COMMUNICATION_AI_TEXT_TOKEN_RESERVATION=4096
COMMUNICATION_AI_IMAGE_TOKEN_RESERVATION=32768

# Optional local smoke credentials.
LOCAL_RUNTIME_USER_EMAIL=local.runtime@example.com
LOCAL_RUNTIME_USER_PASSWORD=ChangeMe123!
