{
	admin off

	log default {
		output stdout
		format filter {
			wrap json {
				message_key ""
			}
			fields {
				request delete
				resp_headers delete
				user_id delete
				err delete
				error delete
				err_id delete
				err_trace delete
			}
		}
	}
}

https://localhost {
	tls internal
	encode zstd gzip

	request_body {
		max_size 12MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy api:10010 {
		health_uri /health
		health_interval 5s
		health_timeout 3s
		lb_try_duration 5s
	}
}
