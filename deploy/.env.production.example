API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com
HTTP_PORT=80
HTTPS_PORT=443
CADDYFILE=./Caddyfile

MONGO_USERNAME=cboard
MONGO_PASSWORD=replace-with-a-url-safe-password-32-chars
MONGO_URL=mongodb://cboard:replace-with-a-url-safe-password-32-chars@mongo:27017/cboard-api?authSource=admin
API_SESSION_SECRET=replace-with-an-independent-session-secret-32-chars
JWT_SECRET=replace-with-an-independent-jwt-signing-secret-32-chars
JWT_ISSUER=cboard-api

CBOARD_APP_URL=https://app.example.com
CBOARD_IOS_APP_URL=
CBUILDER_APP_URL=
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=replace-with-storage-account;AccountKey=replace-with-storage-key;EndpointSuffix=core.windows.net
PRIVATE_LIBRARY_CONTAINER_NAME=cboard-private
SENDGRID_API_KEY=
OPENSYMBOLS_SECRET=
GLOBALSYMBOLS_API_KEY=
PICTOGRAM_IMAGE_PROXY_SECRET=replace-with-an-independent-pictogram-proxy-secret-32-chars
PUBLIC_BOARD_IMAGE_HOSTS=

PHONE_VERIFICATION_REQUIRED=true
PHONE_VERIFICATION_PROVIDER=tencentcloud
PHONE_VERIFICATION_HASH_SECRET=replace-with-an-independent-phone-verification-secret-32-chars
PHONE_VERIFICATION_TENCENTCLOUD_SECRET_ID=replace-with-a-least-privilege-secret-id
PHONE_VERIFICATION_TENCENTCLOUD_SECRET_KEY=replace-with-a-least-privilege-secret-key
PHONE_VERIFICATION_TENCENTCLOUD_SMS_SDK_APP_ID=replace-with-sms-sdk-app-id
PHONE_VERIFICATION_TENCENTCLOUD_SMS_SIGN_NAME=replace-with-approved-sign-name
PHONE_VERIFICATION_TENCENTCLOUD_SMS_TEMPLATE_ID=replace-with-approved-template-id
PHONE_VERIFICATION_TENCENTCLOUD_SMS_TEMPLATE_PARAMETERS=code,minutes
PHONE_VERIFICATION_TENCENTCLOUD_SMS_REGION=
PHONE_VERIFICATION_TENCENTCLOUD_SMS_TIMEOUT_SECONDS=10

AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_REQUEST_TIMEOUT_MS=15000

AI_TTS_API_KEY=
AI_TTS_BASE_URL=
