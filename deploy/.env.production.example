API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
CADDYFILE=./Caddyfile
DEPLOYMENT_PROJECT_NAME=cboard-api-production
DEBIAN_MIRROR=http://deb.debian.org/debian
DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security

MONGO_USERNAME=cboard
MONGO_PASSWORD=replace-with-a-url-safe-password-32-chars
MONGO_URL=mongodb://cboard:replace-with-a-url-safe-password-32-chars@mongo:27017/cboard-api?authSource=admin
API_SESSION_SECRET=replace-with-an-independent-session-secret-32-chars
JWT_SECRET=replace-with-an-independent-jwt-signing-secret-32-chars
JWT_ISSUER=cboard-api

CBOARD_APP_URL=https://app.example.com
# Approved sender address for production authentication mail; leave empty until configured.
EMAIL_FROM=
# Optional authentication-mail frontend origin; use an HTTPS origin in production.
AUTH_EMAIL_APP_URL=
# Care remains disabled until the replica-set, private storage and closure worker
# deployment has been verified. Setting these flags alone is not deployment.
CARE_COLLABORATION_ENABLED=false
CARE_NEXT_ENABLED=false
CARE_PUBLIC_TRIAL_ENABLED=false
CARE_LIFECYCLE_TRANSACTIONS_ENABLED=false
CARE_CLOSURE_CONFIRMATION_ENABLED=false
# Supply independent server-only keys and reviewed policies; no trial is granted here.
CARE_ENCRYPTION_ACTIVE_KEY=
CARE_ENCRYPTION_KEYS=
CARE_TRIAL_POLICY_JSON=
CARE_AI_PRICE_POLICY=
CARE_FAMILY_MEDIA_QUOTA_BYTES=
CARE_FAMILY_MEDIA_QUOTA_MAX_FILES=
CARE_MEDIA_CONTAINER=cboard-care-private
CARE_TRIAL_ACCOUNT_HOURLY_LIMIT=3
CARE_TRIAL_IP_HOURLY_LIMIT=20
# Only used by the explicit Care override/initializer. Prepare this file separately
# with mode 0400 and the Mongo image UID; never put the key contents in this template.
CARE_MONGO_KEY_FILE=
CARE_CLOSURE_WORKER_ENABLED=false
CBOARD_IOS_APP_URL=
CBUILDER_APP_URL=
AZURE_STORAGE_CONNECTION_STRING=
PRIVATE_LIBRARY_CONTAINER_NAME=
SENDGRID_API_KEY=
OPENSYMBOLS_SECRET=
GLOBALSYMBOLS_API_KEY=
# Temporary public v1 runtime bridge; disable when retiring legacy API access.
GLOBALSYMBOLS_LEGACY_RUNTIME_ENABLED=false
PICTOGRAM_IMAGE_PROXY_SECRET=replace-with-an-independent-pictogram-proxy-secret-32-chars
PUBLIC_BOARD_IMAGE_HOSTS=

PHONE_VERIFICATION_REQUIRED=false
PHONE_VERIFICATION_PROVIDER=
PHONE_VERIFICATION_HASH_SECRET=
PHONE_VERIFICATION_TENCENTCLOUD_SECRET_ID=
PHONE_VERIFICATION_TENCENTCLOUD_SECRET_KEY=
PHONE_VERIFICATION_TENCENTCLOUD_SMS_SDK_APP_ID=
PHONE_VERIFICATION_TENCENTCLOUD_SMS_SIGN_NAME=
PHONE_VERIFICATION_TENCENTCLOUD_SMS_TEMPLATE_ID=
PHONE_VERIFICATION_TENCENTCLOUD_SMS_TEMPLATE_PARAMETERS=
PHONE_VERIFICATION_TENCENTCLOUD_SMS_REGION=
PHONE_VERIFICATION_TENCENTCLOUD_SMS_TIMEOUT_SECONDS=10

AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_REQUEST_TIMEOUT_MS=15000
# Optional, server-only resegment compatibility; keep blank until the selected model is verified.
AI_RESEGMENT_REQUEST_OPTIONS=
# Optional sentence override; otherwise reuse bounded resegmentation options.
# Sentences keep line-based text output (never inherit the tokens JSON schema).
AI_SENTENCE_REQUEST_OPTIONS=

AI_TTS_API_KEY=
AI_TTS_BASE_URL=
AI_TTS_MODEL=gpt-4o-mini-tts
AI_TTS_VOICE=alloy
AI_TTS_VOICES=alloy
AI_TTS_TIMEOUT_MS=25000

COMMUNICATION_DIALECT_ASR_PROVIDER=
COMMUNICATION_DIALECT_ASR_TIMEOUT_SECONDS=30
COMMUNICATION_TENCENTCLOUD_ASR_REGION=
COMMUNICATION_TENCENTCLOUD_ASR_SECRET_ID=
COMMUNICATION_TENCENTCLOUD_ASR_SECRET_KEY=
VOLCENGINE_ASR_API_KEY=
VOLCENGINE_ASR_APP_KEY=
VOLCENGINE_ASR_ACCESS_KEY=
VOLCENGINE_ASR_BASE_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
VOLCENGINE_ASR_RESOURCE_ID=volc.bigasr.auc_turbo

BACKGROUND_REMOVAL_PROVIDER=
BACKGROUND_REMOVAL_API_URL=
BACKGROUND_REMOVAL_API_KEY=
BACKGROUND_REMOVAL_TIMEOUT_MS=15000

COMMUNICATION_ENHANCEMENT_RATE_LIMIT_ENABLED=true
COMMUNICATION_ENHANCEMENT_POINTS_PER_MINUTE=30
COMMUNICATION_ENHANCEMENT_MONTHLY_POINTS=1000
COMMUNICATION_AI_TOKEN_QUOTA_ENABLED=true
COMMUNICATION_AI_MONTHLY_TOKEN_QUOTA=1000000
COMMUNICATION_AI_TEXT_TOKEN_RESERVATION=4096
COMMUNICATION_AI_IMAGE_TOKEN_RESERVATION=32768
